---
import DefaultLayout from "@/layouts/default-layout.astro";
import { getCollection } from "astro:content";
import { basename } from "node:path";
import { Code } from "astro-expressive-code/components";
import { CommandTabs } from "@/components/registry/command-tabs";

export async function getStaticPaths() {
  const registryItems = await getCollection("registry");
  return registryItems.map((item) => ({
    params: { name: item.data.name },
    props: { item },
  }));
}

const { item } = Astro.props;
const { name } = Astro.params;

if (!name) {
  return Astro.redirect("/registry");
}

const registryUrl = `${Astro.url.origin}/r/${name}.json`;

// Extract language from file extension and prepare files for display
const files = item.data.files.map((file) => {
  // Extract language from file extension
  const extension = file.path.split(".").pop() || "";
  const langMap: Record<string, string> = {
    ts: "typescript",
    tsx: "tsx",
    js: "javascript",
    jsx: "jsx",
    css: "css",
    scss: "scss",
    json: "json",
    md: "markdown",
    mdx: "mdx",
    html: "html",
    astro: "astro",
  };
  const lang = langMap[extension] || extension;
  const fileName = basename(file.path);
  return {
    ...file,
    lang,
    fileName,
  };
});
---

<DefaultLayout headProps={{ title: `${item.data.title} - Registry` }}>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <a
        href="/registry"
        class="text-muted-foreground hover:text-foreground mb-4 inline-block"
      >
        ← Back to Registry
      </a>
      <h1 class="text-3xl font-bold mb-2">{item.data.title}</h1>
      <p class="text-muted-foreground mb-4">{item.data.description}</p>
      <div class="flex items-center gap-4 text-sm">
        <a
          href={`/r/${name}.json`}
          class="text-primary hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          View JSON
        </a>
        {
          item.data.dependencies && item.data.dependencies.length > 0 && (
            <span class="text-muted-foreground">
              Dependencies: {item.data.dependencies.join(", ")}
            </span>
          )
        }
      </div>
    </div>

    <article class="prose">
      <div class="space-y-6">
        {
          files.map((file) => (
            <div>
              <Code
                code={file.content || ""}
                lang={file.lang}
                title={file.fileName}
              />
            </div>
          ))
        }
      </div>
    </article>

    <div class="mt-8">
      <h3 class="font-semibold mb-2">Install with the shadcn CLI</h3>
      <CommandTabs registryUrl={registryUrl} client:load />
    </div>
  </div>
</DefaultLayout>
