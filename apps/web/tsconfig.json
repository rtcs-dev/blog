{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    ".cloudflare/types",
    "cloudflare.config.ts",
    "**/*"
  ],
  "compilerOptions": {
    "paths": {
      "@/hooks/use-scroll-shrink": ["./registry/nav-01/use-scroll-shrink.ts"],
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
