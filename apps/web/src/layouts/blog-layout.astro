---
import type { CollectionEntry } from "astro:content";
import DefaultLayout from "./default-layout.astro";
import FormattedDate from "@/components/ui/formatted-date.astro";
import DottedBackground from "@/components/layout/dotted-background.astro";
import { PostToc, type TocHeading } from "@/components/blog-post/post-toc";
import "@/styles/post.css";

type Props = CollectionEntry<"posts">["data"] & {
  headings: TocHeading[];
};

const { title, description, date, imageDark, headings } = Astro.props;
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const hasToc = tocHeadings.length > 0;
---

<DefaultLayout
  headProps={{
    title: `${title} | Robert Tabacaru`,
    description,
    image: imageDark,
  }}
>
  <DottedBackground />
  <div class="text-center my-12">
    <h1 class="title">{title}</h1>
    <p class="text-muted-foreground">Robert Tabacaru</p>
    <p>
      <FormattedDate class="text-muted-foreground" date={date} />
    </p>
  </div>
  <div
    class:list={[
      hasToc && "xl:grid xl:grid-cols-[minmax(0,1fr)_13rem] xl:gap-10",
    ]}
  >
    <article class="prose min-w-0">
      <slot />
    </article>
    <PostToc client:load headings={tocHeadings} />
  </div>
</DefaultLayout>
