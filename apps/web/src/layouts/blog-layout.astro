---
import type { CollectionEntry } from "astro:content";
import DefaultLayout from "./default-layout.astro";
import FormattedDate from "@/components/ui/formatted-date.astro";
import DottedBackground from "@/components/layout/dotted-background.astro";
import {
  PostToc,
  type PostSeriesContext,
  type TocHeading,
} from "@/components/blog-post/post-toc";
import {
  getSeriesNeighbors,
  seriesHref,
  type SeriesMember,
} from "@/lib/posts/series";
import "@/styles/post.css";

type Props = CollectionEntry<"posts">["data"] & {
  headings: TocHeading[];
  seriesMembers?: SeriesMember[];
  currentId?: string;
};

const {
  title,
  description,
  date,
  imageDark,
  headings,
  series,
  seriesMembers,
  currentId,
} = Astro.props;
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const seriesContext: PostSeriesContext | undefined = (() => {
  if (!series || !currentId || !seriesMembers?.length) return undefined;
  const neighbors = getSeriesNeighbors(seriesMembers, currentId);
  if (neighbors.position < 1) return undefined;
  return {
    name: series.name,
    href: seriesHref(series.name),
    icon: series.icon,
    position: neighbors.position,
    total: seriesMembers.length,
    previous: neighbors.previous
      ? { id: neighbors.previous.id, title: neighbors.previous.title }
      : undefined,
    next: neighbors.next
      ? { id: neighbors.next.id, title: neighbors.next.title }
      : undefined,
  };
})();
const showRail = tocHeadings.length > 0 || Boolean(seriesContext);
---

<DefaultLayout
  headProps={{
    title: `${title} | Robert Tabacaru`,
    description,
    image: imageDark,
  }}
>
  <DottedBackground />
  <div class="text-center my-12">
    <h1 class="title">{title}</h1>
    <p class="text-muted-foreground">Robert Tabacaru</p>
    <p>
      <FormattedDate class="text-muted-foreground" date={date} />
    </p>
  </div>
  <div
    class:list={[
      showRail && "xl:grid xl:grid-cols-[minmax(0,1fr)_13rem] xl:gap-10",
    ]}
  >
    <div class="min-w-0">
      <article class="prose min-w-0">
        <slot />
      </article>
    </div>
    <PostToc client:load headings={tocHeadings} series={seriesContext} />
  </div>
</DefaultLayout>
