---
import { ButtonArrow, buttonVariants } from "@/components/ui/button";
import FormattedDate from "@/components/ui/formatted-date.astro";
import BlogPostRow from "@/components/blog/blog-post-row.astro";
import { postLink, postLinkTitle } from "@/components/blog/post-link";
import type { PostEntry } from "@/lib/posts";
import {
  seriesHref,
  seriesSlidePosts,
  type BlogIndexPost,
  type BlogIndexSeries,
} from "@/lib/posts/series";
import { cn } from "@/lib/utils";
import "@/styles/blog-listing.css";

type Props = {
  featured?: PostEntry;
  series?: BlogIndexSeries;
  posts: BlogIndexPost[];
};

const { featured, series, posts } = Astro.props;
const seriesSlide = series ? seriesSlidePosts(series.posts) : [];
const hiddenSeriesCount = series ? series.posts.length - seriesSlide.length : 0;
const heroSizes =
  "(min-width: 1024px) 26rem, (min-width: 768px) 20rem, calc(100vw - 3rem)";
---

{
  featured && (
    <section class="blog-section" aria-labelledby="latest-post-heading">
      <h1 id="latest-post-heading" class="blog-section-title mb-4">
        Latest post
      </h1>
      <a
        class:list={[postLink, "blog-feature"]}
        href={`/posts/${featured.id}`}
        aria-labelledby={`post-title-${featured.id}`}
      >
        <div class="order-2 min-w-0 md:order-1">
          <div class="blog-row">
            <div class="blog-meta">
              <FormattedDate class="blog-date" date={featured.data.date} />
              {featured.data.series && (
                <span class="blog-part">Part {featured.data.series.order}</span>
              )}
              {featured.data.status === "draft" && (
                <span class="blog-draft">Draft</span>
              )}
            </div>
            <div class="min-w-0">
              {featured.data.series && (
                <p class="blog-featured-kicker">{featured.data.series.name}</p>
              )}
              <h2
                id={`post-title-${featured.id}`}
                class:list={[postLinkTitle, "blog-featured-title"]}
              >
                {featured.data.title}
              </h2>
              {featured.data.description && (
                <p class="blog-featured-summary">{featured.data.description}</p>
              )}
            </div>
          </div>
        </div>
        <div class="order-1 overflow-hidden rounded-md md:order-2">
          <img
            class="blog-cover-image block dark:hidden"
            src={featured.data.imageLight}
            alt=""
            width="1200"
            height="630"
            sizes={heroSizes}
            loading="eager"
          />
          <img
            class="blog-cover-image hidden dark:block"
            src={featured.data.imageDark}
            alt=""
            width="1200"
            height="630"
            sizes={heroSizes}
            loading="eager"
          />
        </div>
      </a>
    </section>
  )
}

{
  series && (
    <section class="blog-section" aria-labelledby="latest-series-heading">
      <div class="mb-4 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 sm:gap-y-3">
        <h2 id="latest-series-heading" class="blog-section-title">
          Latest series
        </h2>
        {import.meta.env.DEV && (
          <a
            class={cn(
              buttonVariants({ variant: "muted" }),
              "h-auto shrink-0 px-0 whitespace-nowrap sm:ml-auto",
            )}
            href="/series"
          >
            Explore more series
            <ButtonArrow />
          </a>
        )}
      </div>
      <div class="blog-series-head">
          <div class="blog-row">
            <div class="hidden md:block" aria-hidden="true"></div>
            <div class="flex min-w-0 flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
              <h3 class="blog-series-name">{series.name}</h3>
              <a
                class={cn(
                  buttonVariants({ variant: "link" }),
                  "h-auto shrink-0 px-0",
                )}
                href={seriesHref(series.name)}
              >
                View all
                <span class="sr-only"> {series.name} parts</span>
              </a>
            </div>
          </div>
        </div>
        <ol class="blog-series-list">
          {seriesSlide.map((post, index) => (
            <>
              {index > 0 && hiddenSeriesCount > 0 && (
                <li aria-hidden="true">
                  <div class="blog-omitted">
                    <div class="blog-row">
                      <span class="hidden md:block"></span>
                      <p class="blog-between">···</p>
                    </div>
                  </div>
                </li>
              )}
              <li>
                <BlogPostRow
                  post={post}
                  heading="h4"
                  headingId={`series-part-${post.id}`}
                  variant="series"
                />
              </li>
            </>
          ))}
        </ol>
    </section>
  )
}

{
  posts.length > 0 && (
    <section class="blog-section" aria-labelledby="posts-heading">
      <h2 id="posts-heading" class="blog-section-title mb-4">
        Posts
      </h2>
      <div class="flex flex-col gap-4">
        {posts.map((post) => (
          <BlogPostRow
            post={post}
            heading="h3"
            headingId={`post-title-${post.id}`}
          />
        ))}
      </div>
    </section>
  )
}
