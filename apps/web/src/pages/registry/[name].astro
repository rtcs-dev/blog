---
import DefaultLayout from "@/layouts/default-layout.astro";
import { getCollection } from "astro:content";
import { basename } from "node:path";
import { Code } from "astro-expressive-code/components";
import { CommandTabs } from "@/components/registry/command-tabs";
import { RegistryDetail } from "@/components/registry/registry-detail";
import PropsTable from "@/components/registry/props-table.astro";
import { propsFor } from "@/components/registry/registry-items";
import { registryTypeLabel } from "@/components/registry/registry-modules";
import { buttonVariants } from "@/components/ui/button";

export async function getStaticPaths() {
  const registryItems = await getCollection("registry");
  return registryItems.map((item) => ({
    params: { name: item.data.name },
    props: { item },
  }));
}

const { item } = Astro.props;
const { name } = Astro.params;

if (!name) {
  return Astro.redirect("/registry");
}

const registryUrl = `${Astro.url.origin}/r/${name}.json`;
const props = propsFor(name);
const typeLabel = registryTypeLabel(item.data.type);

const files = item.data.files.map((file) => {
  const extension = file.path.split(".").pop() || "";
  const langMap: Record<string, string> = {
    ts: "typescript",
    tsx: "tsx",
    js: "javascript",
    jsx: "jsx",
    css: "css",
    scss: "scss",
    json: "json",
    md: "markdown",
    mdx: "mdx",
    html: "html",
    astro: "astro",
  };
  const lang = langMap[extension] || extension;
  const fileName = basename(file.path);
  return {
    ...file,
    lang,
    fileName,
  };
});
---

<DefaultLayout headProps={{ title: `${item.data.title} - Registry` }}>
  <div>
    <div class="mb-8 flex flex-col gap-3">
      <a
        class={buttonVariants({ variant: "ghost", className: "self-start" })}
        href="/registry"
      >
        ← Back to Registry
      </a>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-bold">{item.data.title}</h1>
        <span class="rounded bg-muted px-2 py-1 text-xs">{typeLabel}</span>
      </div>
      <p class="text-muted-foreground">{item.data.description}</p>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <a
          class={buttonVariants({ variant: "link" })}
          href={`/r/${name}.json`}
          target="_blank"
          rel="noopener noreferrer"
        >
          View JSON
        </a>
        {
          item.data.dependencies.length > 0 && (
            <span class="text-muted-foreground">
              Dependencies: {item.data.dependencies.join(", ")}
            </span>
          )
        }
      </div>
    </div>

    <RegistryDetail client:load name={name}>
      <div class="flex flex-col gap-6">
        {
          files.map((file) => (
            <Code code={file.content || ""} lang={file.lang} title={file.fileName} />
          ))
        }
      </div>
    </RegistryDetail>

    {
      props.length > 0 && (
        <section class="mt-10 flex flex-col gap-3">
          <h2 class="text-lg font-semibold">Props</h2>
          <PropsTable rows={props} />
        </section>
      )
    }

    <div class="mt-10 flex flex-col gap-2">
      <h2 class="text-lg font-semibold">Install with the shadcn CLI</h2>
      <CommandTabs registryUrl={registryUrl} client:load />
    </div>
  </div>
</DefaultLayout>
