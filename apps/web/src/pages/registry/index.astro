---
import DefaultLayout from "@/layouts/default-layout.astro";
import { RegistryIndex } from "@/components/registry/registry-index";
import registryData from "../../../public/r/registry.json";

const registryItems = registryData.items;
---

<DefaultLayout
  headProps={{
    title: "Registry - Robert Tabacaru",
    description:
      "Utilities, UI primitives, and blocks I reuse across my projects.",
  }}
>
  <div>
    <div class="mb-8 flex flex-col gap-3">
      <h1 class="text-3xl font-bold">Registry</h1>
      <p class="text-muted-foreground">
        Utilities, UI primitives, and blocks I reuse across my projects.
      </p>
    </div>

    <RegistryIndex
      client:load
      items={registryItems}
      origin={Astro.url.origin}
    />
  </div>
</DefaultLayout>
