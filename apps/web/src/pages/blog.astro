---
import BlogIndex from "@/components/blog/blog-index.astro";
import DefaultLayout from "@/layouts/default-layout.astro";
import { getPosts } from "@/lib/posts";
import { buildBlogIndex, pickFeaturedPost } from "@/lib/posts/series";

const posts = await getPosts();
const featured = pickFeaturedPost(posts);
const index = buildBlogIndex(posts, featured?.id);
const highlightedSeries = index.series[0];
---

<DefaultLayout headProps={{ title: "Blog - Robert Tabacaru" }}>
  <div class="pt-4 md:pt-8">
    <BlogIndex
      featured={featured}
      series={highlightedSeries}
      posts={index.posts}
    />
  </div>
</DefaultLayout>
