---
import BlogLayout from "@/layouts/blog-layout.astro";
import { includeDraftPosts } from "@/lib/env";
import { getPosts } from "@/lib/posts";
import { getSeriesMembers } from "@/lib/posts/series";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);

const seriesName = post.data.series?.name;
const seriesMembers = seriesName
  ? getSeriesMembers(posts, seriesName, {
      includeDrafts: includeDraftPosts(),
    })
  : [];
---

<BlogLayout
  {...post.data}
  headings={headings}
  seriesMembers={seriesMembers}
  currentId={post.id}
>
  <Content />
</BlogLayout>
