{
  "name": "web",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "astro": "astro",
    "build": "astro check && pnpm run build:registry && cf build",
    "build:registry": "pnpm run copy:registry && shadcn build -o public/r",
    "copy:registry": "cp -r registry.json public/r/registry.json",
    "dev": "pnpm run build:registry && cf dev",
    "preview": "pnpm run build:registry && cf dev",
    "start": "cf dev",
    "login": "cf auth login",
    "deploy": "pnpm run build && cf deploy --prebuilt --mode production",
    "deploy:preview": "pnpm run build && cf previews deploy --prebuilt --mode production",
    "types": "cf workers types",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "convert-images": "node --experimental-strip-types scripts/convert-images-to-webp.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "15.0.0-beta.5",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@base-ui/react": "^1.8.0",
    "@emnapi/runtime": "1.11.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "7.4.12",
    "astro-expressive-code": "^0.44.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2",
    "vgpu": "^0.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vgpu/wgsl": "0.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@webgpu/types": "^0.1.72",
    "cf": "1.0.0-beta.32",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.33.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^5.0.0"
  }
}
