{
  "name": "rtcs-blog",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "astro": "astro",
    "build": "astro check && pnpm run build:registry && astro build",
    "build:registry": "pnpm run copy:registry && shadcn build -o public/r",
    "copy:registry": "cp -r registry.json public/r/registry.json",
    "dev": "pnpm run build:registry && astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "login": "wrangler login",
    "deploy": "astro build && wrangler deploy",
    "deploy:preview": "astro build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "convert-images": "node --experimental-strip-types scripts/convert-images-to-webp.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/open-sans": "^5.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "7.3.1",
    "astro-expressive-code": "^0.44.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.555.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "shadcn": "^2.5.0",
    "sharp": "^0.33.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
